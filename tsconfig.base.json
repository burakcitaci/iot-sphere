{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "@gateway/open-telemetry-library": [
        "apps/backend/shared/open-telemetry-library/src/index.ts"
      ],
      "@gateway/otel-library": [
        "apps/backend/shared/otel-library/src/index.ts"
      ],
      "entity-lib": ["shared/entity-lib/src/index.ts"]
    }
  }
}
